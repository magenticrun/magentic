{
  "name": "magentic",
  "private": true,
  "description": "The agent harness your team can actually share.",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "4.0.0-rc.115",
      "@effect/platform-bun": "4.0.0-rc.115",
      "@effect/ai-openai": "4.0.0-rc.115",
      "@effect/ai-anthropic": "4.0.0-rc.115",
      "@effect/ai-openai-compat": "4.0.0-rc.115",
      "@clack/prompts": "1.8.1",
      "@opentui/core": "0.5.11",
      "@opentui/solid": "0.5.11",
      "solid-js": "1.9.15",
      "@modelcontextprotocol/client": "2.0.0",
      "turndown": "7.2.4",
      "@types/turndown": "5.0.6",
      "@mozilla/readability": "0.6.0",
      "linkedom": "0.18.13",
      "@opentui/qrcode": "0.5.11",
      "@babel/core": "7.29.7",
      "babel-preset-solid": "1.9.15",
      "@types/babel__core": "7.20.5"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript",
    "dev": "bun run --no-orphans --filter @magentic/gateway dev",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/cli/tsconfig.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "oxlint && oxfmt --check",
    "knip": "knip",
    "format": "oxlint --fix; oxfmt",
    "check": "bun run --parallel --no-exit-on-error typecheck lint knip test"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.115",
    "@magentic/bridge-github": "workspace:*",
    "@magentic/plugin": "workspace:*",
    "@magentic/protocol": "workspace:*",
    "@oxlint/plugins": "1.83.0",
    "@types/bun": "1.4.2",
    "effect": "catalog:",
    "knip": "6.37.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.1"
  }
}
