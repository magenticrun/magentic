{
  "name": "magentic",
  "private": true,
  "description": "The agent harness your team can actually share.",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "4.0.0-rc.112",
      "@effect/platform-bun": "4.0.0-rc.112",
      "@effect/ai-openai": "4.0.0-rc.112",
      "@effect/ai-anthropic": "4.0.0-rc.112",
      "@effect/ai-openai-compat": "4.0.0-rc.112",
      "@clack/prompts": "1.7.0",
      "@opentui/core": "0.5.10",
      "@opentui/solid": "0.5.10",
      "solid-js": "1.9.12",
      "@modelcontextprotocol/client": "2.0.0",
      "turndown": "7.2.0",
      "@types/turndown": "5.0.5",
      "@mozilla/readability": "0.6.0",
      "linkedom": "0.18.12"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript",
    "dev": "bun run --no-orphans --filter @magentic/gateway dev",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/cli/tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "oxlint && oxfmt --check",
    "knip": "knip",
    "format": "oxlint --fix; oxfmt",
    "check": "bun run --parallel --no-exit-on-error typecheck lint knip test"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.40.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@magentic/bridge-github": "workspace:*",
    "@magentic/plugin": "workspace:*",
    "@magentic/protocol": "workspace:*",
    "@oxlint/plugins": "1.81.0",
    "@types/bun": "^1.4.0",
    "effect": "catalog:",
    "knip": "6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "^4.1.11"
  }
}
