{
  "manifest_version": 3,
  "name": "Magentic Browser Bridge",
  "version": "0.1.0",
  "description": "Lets a local Magentic gateway control tabs in Helium through Chrome DevTools Protocol.",
  "permissions": ["debugger", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Magentic Browser Bridge"
  }
}
