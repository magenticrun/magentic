{
  "name": "@magentic/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal client for a magentic gateway.",
  "bin": {
    "magentic": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "smoke": "bun scripts/tui-smoke.ts",
    "test": "bun --bun vitest run --root ../.. apps/cli"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@magentic/core": "workspace:*",
    "@magentic/gateway": "workspace:*",
    "@magentic/model": "workspace:*",
    "@magentic/plugin": "workspace:*",
    "@magentic/protocol": "workspace:*",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "effect": "catalog:",
    "solid-js": "catalog:"
  }
}
