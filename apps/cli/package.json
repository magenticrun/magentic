{
  "name": "@magentic/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal client for a magentic gateway.",
  "bin": {
    "magentic": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
