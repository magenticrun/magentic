{
  "name": "@magentic/relay",
  "version": "0.1.0",
  "private": true,
  "description": "Reverse tunnel that lets a magentic gateway on a laptop be reached from a phone.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./connector": "./src/connector.ts"
  },
  "scripts": {
    "dev": "bun run bin/relay.ts",
    "connect": "bun run bin/connect.ts",
    "test": "bun --bun vitest run --root ../.. apps/relay/test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "oxlint",
    "check": "bun run typecheck && bun run lint && bun run test",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/bun": "1.4.2",
    "oxlint": "1.83.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.129.0"
  }
}
